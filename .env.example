# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Model to use (default: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: Host port (default: 8080)
PORT=8080

# Optional: Max output tokens (default: 24000)
MAX_OUTPUT_TOKENS=24000

# Optional: Max commentaries to fetch (default: 3)
MAX_COMMENTARIES=3

# Optional: Max verses per request (default: 15)
MAX_VERSES=15
